{
  "_comment": "What the GitHub repository should look like. host/tools/github-settings.py compares it with GitHub and, with --apply, makes GitHub match. Edit here, not in the web interface.",
  "repository": {
    "description": "Drum synth plugins (CLAP) running the sound engine of the LXR-02 by Sonic Potions and Erica Synths. Not affiliated with either.",
    "homepage": "https://www.oikoaudio.com",
    "topics": [
      "clap",
      "drum-synth",
      "audio-plugin",
      "synthesizer",
      "lxr"
    ],
    "has_issues": true,
    "has_wiki": false,
    "has_discussions": false,
    "has_projects": false,
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": true,
    "delete_branch_on_merge": true
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "selected",
    "selected": {
      "github_owned_allowed": true,
      "verified_allowed": false,
      "patterns_allowed": []
    },
    "workflow": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": false
    },
    "fork_pr_approval": "all_external_contributors"
  },
  "security": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "private_vulnerability_reporting": true,
    "vulnerability_alerts": true
  },
  "rulesets": [
    {
      "name": "main",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "required_linear_history"
        }
      ]
    },
    {
      "name": "main checks and reviews",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "~DEFAULT_BRANCH"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ],
      "rules": [
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 1,
            "require_code_owner_review": true,
            "dismiss_stale_reviews_on_push": true,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "allowed_merge_methods": [
              "squash",
              "rebase"
            ]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              {
                "context": "Linux",
                "integration_id": 15368
              },
              {
                "context": "Windows",
                "integration_id": 15368
              },
              {
                "context": "macOS",
                "integration_id": 15368
              }
            ]
          }
        }
      ]
    },
    {
      "name": "release tags",
      "target": "tag",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "include": [
            "refs/tags/v*"
          ],
          "exclude": []
        }
      },
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ],
      "rules": [
        {
          "type": "creation"
        },
        {
          "type": "update"
        },
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ]
    }
  ]
}
