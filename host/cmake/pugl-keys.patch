--- a/src/x11.c
+++ b/src/x11.c
@@ -887,6 +887,20 @@ lookupString(XIC xic, XEvent* const xevent, char* const str, KeySym* const sym)
   return status == XBufferOverflow ? 0 : n;
 }
 
+static void
+forwardKey(PuglView* const view, XEvent xevent)
+{
+  // Pass an unhandled key on to the parent window, for example a plugin host
+  if (view->parent) {
+    xevent.xkey.window = (Window)view->parent;
+    XSendEvent(view->world->impl->display,
+               (Window)view->parent,
+               True,
+               xevent.type == KeyPress ? KeyPressMask : KeyReleaseMask,
+               &xevent);
+  }
+}
+
 static void
 translateKey(PuglView* const view, XEvent* const xevent, PuglEvent* const event)
 {
@@ -920,7 +934,11 @@ translateKey(PuglView* const view, XEvent* const xevent, PuglEvent* const event)
     const int sfound  = lookupString(view->impl->xic, xevent, sstr, &sym);
     if (sfound > 0) {
       // Dispatch key event now
-      puglDispatchEvent(view, event);
+      if (puglDispatchEvent(view, event)) {
+        forwardKey(view, *xevent);
+        event->type = PUGL_NOTHING;
+        return;
+      }
 
       // "Return" a text event in its place
       event->text.type      = PUGL_TEXT;
@@ -1984,6 +2002,12 @@ dispatchX11Events(PuglWorld* const world)
         XUnsetICFocus(view->impl->xic);
       }
       break;
+    case PUGL_KEY_PRESS:
+    case PUGL_KEY_RELEASE:
+      if (puglDispatchEvent(view, &event)) {
+        forwardKey(view, xevent);
+      }
+      break;
     default:
       // Dispatch event to application immediately
       st = puglDispatchEvent(view, &event);
