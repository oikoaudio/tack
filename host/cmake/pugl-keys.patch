diff --git a/src/win.c b/src/win.c
index 5b74c10..6a22107 100644
--- a/src/win.c
+++ b/src/win.c
@@ -997,7 +997,15 @@ handleMessage(PuglView* view, UINT message, WPARAM wParam, LPARAM lParam)
     return DefWindowProc(view->impl->hwnd, message, wParam, lParam);
   }
 
-  puglDispatchEvent(view, &event);
+  if (puglDispatchEvent(view, &event) && view->parent &&
+      (message == WM_KEYDOWN || message == WM_KEYUP ||
+       message == WM_SYSKEYDOWN || message == WM_SYSKEYUP)) {
+    // Unhandled, pass it on to the top-level window, for example a plugin host
+    HWND root = GetAncestor(view->impl->hwnd, GA_ROOT);
+    if (root && root != view->impl->hwnd) {
+      SendMessage(root, message, wParam, lParam);
+    }
+  }
 
   return 0;
 }
diff --git a/src/x11.c b/src/x11.c
