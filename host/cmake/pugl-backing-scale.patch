+- (void)viewDidChangeBackingProperties
+{
+  // A new backing scale, as on another screen: the view has as many points but more or fewer pixels. AppKit doesn't
+  // reshape the view for it, so mark it reshaped, which sends a configure with its new size in pixels before the
+  // next expose
+  PuglWrapperView* wrapper = (PuglWrapperView*)[self superview];
+
+  [super viewDidChangeBackingProperties];
+  [[self openGLContext] update];
+  [wrapper setReshaped];
+  [self setNeedsDisplay:YES];
+}
