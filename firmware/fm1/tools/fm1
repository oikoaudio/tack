#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# The tools for a connected FM-1, in a Python environment of their own.
#   fm1 info | install [PACKAGE] | log | kits DIR
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
root=$(cd "$here/../../.." && pwd)
venv=$here/../.venv
tools=$root/third_party/fm1-base/tools
if [ ! -x "$venv/bin/python" ]; then
    python3 -m venv "$venv"
    "$venv/bin/pip" install -q -r "$here/requirements.txt"
fi
py=$venv/bin/python
cmd=${1:-}
[ $# -gt 0 ] && shift

# A program holding the FM-1's MIDI port can leave these tools waiting on it, past Ctrl+C. On Linux the kernel says who
# has it. FM1_FORCE=1 goes ahead anyway
port_free() {
    local card pid name who=""
    [ -z "${FM1_FORCE:-}" ] && [ -r /proc/asound/cards ] && command -v fuser > /dev/null || return 0
    card=$(awk '/\[FM1 *\]/ {print $1}' /proc/asound/cards)
    [ -n "$card" ] && [ -e "/dev/snd/midiC${card}D0" ] || return 0
    for pid in $(fuser "/dev/snd/midiC${card}D0" 2> /dev/null || true); do
        name=$(ps -o comm= -p "$pid" 2> /dev/null || true)
        case $name in
            pipewire*|wireplumber*) ;;
            *) who="$who ${name:-pid $pid}" ;;
        esac
    done
    [ -z "$who" ] && return 0
    echo "The FM-1's MIDI port is in use by:$who" >&2
    echo "Close that first, or set FM1_FORCE=1 to go ahead anyway." >&2
    exit 1
}
case $cmd in
    info|install|log|kits|backup|restore) port_free ;;
esac

case $cmd in
    info) exec "$py" "$tools/fm1_install.py" --info --port TACK "$@" ;;
    install)
        pkg=${1:-$here/../build/tack.fwsc}
        [ $# -gt 0 ] && shift
        exec "$py" "$tools/fm1_install.py" "$pkg" --port TACK --yes "$@" ;;
    log) exec "$py" "$tools/fm1_remote.py" --port TACK log "$@" ;;
    kits) exec "$py" "$here/fm1_kits.py" "$@" ;;
    *) sed -n 3,4p "$0" >&2; exit 2 ;;
esac
